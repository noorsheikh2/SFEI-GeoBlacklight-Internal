<% Geoblacklight.deprecation.silence do %>
  <%= render_static_map_component %>
  <%= render_show_tools %>

  <% sidecar = document.respond_to?(:sidecar) ? document.sidecar : nil %>
  <% primary = sidecar&.primary_image %>
  <% all_imgs = sidecar&.all_images || [] %>

  <% if primary.present? %>
    <% modal_id = "sidebar-image-lightbox-#{document.id.to_s.parameterize}" %>
    <% has_multiple = all_imgs.size > 1 %>
    <div class="card mb-3 shadow-sm border-0 document-sidebar-thumbnail">
      <div class="card-body p-2 text-center bg-light rounded">
        <a href="#<%= modal_id %>" role="button" data-bs-toggle="modal" data-bs-target="#<%= modal_id %>" title="Click to enlarge image">
          <%= helpers.image_tag primary.variant(resize_to_fit: [400, 400]), class: "img-fluid rounded shadow-sm", style: "max-height: 250px; width: 100%; object-fit: contain; cursor: pointer;", alt: document.title %>
        </a>
        <div class="small text-muted mt-1" style="font-size: 0.8rem; cursor: pointer;" role="button" tabindex="0" data-bs-toggle="modal" data-bs-target="#<%= modal_id %>">
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="currentColor" class="me-1" viewBox="0 0 16 16" aria-hidden="true">
            <path fill-rule="evenodd" d="M6.5 12a5.5 5.5 0 1 0 0-11 5.5 5.5 0 0 0 0 11M13 6.5a6.5 6.5 0 1 1-13 0 6.5 6.5 0 0 1 13 0"/>
            <path d="M10.344 11.742q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1 6.5 6.5 0 0 1-1.398 1.4z"/>
            <path fill-rule="evenodd" d="M6.5 3a.5.5 0 0 1 .5.5V6h2.5a.5.5 0 0 1 0 1H7v2.5a.5.5 0 0 1-1 0V7H3.5a.5.5 0 0 1 0-1H6V3.5a.5.5 0 0 1 .5-.5"/>
          </svg><%= has_multiple ? "Click to enlarge (#{all_imgs.size} images)" : "Click to enlarge" %>
        </div>
      </div>
    </div>

    <!-- Lightbox Modal -->
    <div class="modal fade" id="<%= modal_id %>" tabindex="-1" aria-labelledby="<%= modal_id %>-title" aria-hidden="true" data-controller="lightbox-carousel">
      <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title text-truncate me-2" id="<%= modal_id %>-title"><%= document.title %></h5>
            <div class="d-flex align-items-center ms-auto">
              <% if has_multiple %>
                <span class="badge bg-secondary me-2 text-nowrap" data-lightbox-carousel-target="counter">Image 1 of <%= all_imgs.size %></span>
              <% end %>
              <%= helpers.link_to helpers.rails_blob_path(primary, disposition: "inline"), target: "_blank", rel: "noopener", class: "btn btn-sm btn-outline-secondary me-2 text-nowrap", data: { lightbox_carousel_target: "fullSizeLink" }, title: "Open full-resolution image in new tab" do %>
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="currentColor" class="me-1" viewBox="0 0 16 16" aria-hidden="true">
                  <path fill-rule="evenodd" d="M8.636 3.5a.5.5 0 0 0-.5-.5H1.5A1.5 1.5 0 0 0 0 4.5v10A1.5 1.5 0 0 0 1.5 16h10a1.5 1.5 0 0 0 1.5-1.5V7.864a.5.5 0 0 0-1 0V14.5a.5.5 0 0 1-.5.5h-10a.5.5 0 0 1-.5-.5v-10a.5.5 0 0 1 .5-.5h6.636a.5.5 0 0 0 .5-.5"/>
                  <path fill-rule="evenodd" d="M16 .5a.5.5 0 0 0-.5-.5h-5a.5.5 0 0 0 0 1h3.793L6.146 9.146a.5.5 0 1 0 .708.708L15 1.707V5.5a.5.5 0 0 0 1 0z"/>
                </svg>Open full size
              <% end %>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
          </div>
          <div class="modal-body text-center p-3 bg-dark">
            <% if has_multiple %>
              <div id="<%= modal_id %>-carousel" class="carousel slide" data-bs-interval="false" data-bs-keyboard="true" tabindex="0">
                <!-- Indicators (dots) -->
                <div class="carousel-indicators mb-0" style="bottom: -20px;">
                  <% all_imgs.each_with_index do |_img, idx| %>
                    <button type="button" data-bs-target="#<%= modal_id %>-carousel" data-bs-slide-to="<%= idx %>" class="<%= 'active' if idx == 0 %>" aria-current="<%= 'true' if idx == 0 %>" aria-label="Slide <%= idx + 1 %>"></button>
                  <% end %>
                </div>

                <!-- Carousel Items -->
                <div class="carousel-inner pb-4">
                  <% all_imgs.each_with_index do |img, idx| %>
                    <% full_url = helpers.rails_blob_path(img, disposition: "inline") %>
                    <div class="carousel-item <%= 'active' if idx == 0 %>" data-slide-index="<%= idx + 1 %>" data-total-slides="<%= all_imgs.size %>" data-full-url="<%= full_url %>">
                      <%= image_tag img.variant(resize_to_fit: [1200, 1200]), class: "img-fluid rounded mx-auto d-block", style: "max-height: 75vh; max-width: 100%; object-fit: contain;", alt: "#{document.title} - Image #{idx + 1}" %>
                    </div>
                  <% end %>
                </div>

                <!-- Controls -->
                <button class="carousel-control-prev" type="button" data-bs-target="#<%= modal_id %>-carousel" data-bs-slide="prev" aria-label="Previous">
                  <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                  <span class="visually-hidden">Previous</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#<%= modal_id %>-carousel" data-bs-slide="next" aria-label="Next">
                  <span class="carousel-control-next-icon" aria-hidden="true"></span>
                  <span class="visually-hidden">Next</span>
                </button>
              </div>
            <% else %>
              <%= image_tag primary, class: "img-fluid rounded", style: "max-height: 80vh; max-width: 100%; object-fit: contain;", alt: document.title %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <div class="sidebar-buttons">
    <% sidebar_buttons.each do | sidebar_button | %>
      <%= render sidebar_button %>
    <% end %>
  </div>

  <%= render_more_like_this %>

  <%= render "relations_container", document: document %>
<% end %>
